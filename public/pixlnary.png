<svg width="800" height="600" xmlns="http://www.w3.org/2000/svg">
  <!-- Background gradient -->
  <defs>
    <linearGradient id="bgGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0a0a1a;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#1a0a2a;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0a1a2a;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="neonGradient" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#00f5d4;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#ff5cf4;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#5aff3d;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="800" height="600" fill="url(#bgGradient)"/>
  
  <!-- Grid pattern -->
  <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
    <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#1a1a3a" stroke-width="1" opacity="0.3"/>
  </pattern>
  <rect width="800" height="600" fill="url(#grid)"/>
  
  <!-- Title -->
  <text x="400" y="150" font-family="Arial, sans-serif" font-size="72" font-weight="bold" fill="url(#neonGradient)" text-anchor="middle" style="text-shadow: 0 0 20px rgba(0,245,212,0.8);">
    PIXLNARY
  </text>
  
  <!-- Subtitle -->
  <text x="400" y="200" font-family="Arial, sans-serif" font-size="24" fill="#8cf4ff" text-anchor="middle" opacity="0.9">
    Real-time Drawing &amp; Guessing Game
  </text>
  
  <!-- Pixel grid representation -->
  <g transform="translate(200, 280)">
    <!-- Sample pixel grid -->
    <rect x="0" y="0" width="400" height="200" fill="#050505" stroke="#00f5d4" stroke-width="3" opacity="0.8"/>
    <!-- Sample pixels -->
    <rect x="20" y="20" width="20" height="20" fill="#ff3864"/>
    <rect x="60" y="20" width="20" height="20" fill="#f9c846"/>
    <rect x="100" y="20" width="20" height="20" fill="#5aff3d"/>
    <rect x="140" y="20" width="20" height="20" fill="#00f5d4"/>
    <rect x="180" y="20" width="20" height="20" fill="#433cde"/>
    <rect x="220" y="20" width="20" height="20" fill="#ff5cf4"/>
    <rect x="40" y="60" width="20" height="20" fill="#ff3864"/>
    <rect x="80" y="60" width="20" height="20" fill="#f9c846"/>
    <rect x="120" y="60" width="20" height="20" fill="#5aff3d"/>
    <rect x="160" y="60" width="20" height="20" fill="#00f5d4"/>
    <rect x="200" y="60" width="20" height="20" fill="#433cde"/>
    <rect x="240" y="60" width="20" height="20" fill="#ff5cf4"/>
    <rect x="60" y="100" width="20" height="20" fill="#ff3864"/>
    <rect x="100" y="100" width="20" height="20" fill="#f9c846"/>
    <rect x="140" y="100" width="20" height="20" fill="#5aff3d"/>
    <rect x="180" y="100" width="20" height="20" fill="#00f5d4"/>
    <rect x="220" y="100" width="20" height="20" fill="#433cde"/>
    <rect x="260" y="100" width="20" height="20" fill="#ff5cf4"/>
    <rect x="80" y="140" width="20" height="20" fill="#ff3864"/>
    <rect x="120" y="140" width="20" height="20" fill="#f9c846"/>
    <rect x="160" y="140" width="20" height="20" fill="#5aff3d"/>
    <rect x="200" y="140" width="20" height="20" fill="#00f5d4"/>
    <rect x="240" y="140" width="20" height="20" fill="#433cde"/>
    <rect x="280" y="140" width="20" height="20" fill="#ff5cf4"/>
  </g>
  
  <!-- Tech badges -->
  <g transform="translate(400, 520)">
    <text x="0" y="0" font-family="Arial, sans-serif" font-size="16" fill="#8cf4ff" text-anchor="middle" opacity="0.7">
      React • Socket.io • Node.js • Express
    </text>
  </g>
</svg>

